{
  "name": "@surgijs/ui",
  "version": "1.0.0",
  "description": "Accessible SurgiJS web components, themed with CSS custom properties and ready for SSR.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "keywords": [
    "surgijs",
    "web-components",
    "custom-elements",
    "ui",
    "design-system",
    "a11y"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurgiJS/surgijs.git",
    "directory": "packages/ui"
  },
  "homepage": "https://surgijs.github.io/surgijs/",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/SurgiJS/surgijs/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./themes.css": "./dist/themes.css",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "node scripts/manifest.mjs"
  },
  "peerDependencies": {
    "@surgijs/core": "workspace:^",
    "react": ">=19",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@surgijs/compiler": "workspace:*",
    "@surgijs/core": "workspace:*",
    "@types/react": "^19.2.2",
    "happy-dom": "^20.0.10",
    "react": "^19.2.0",
    "typescript": "~6.0.3",
    "vue": "^3.5.45"
  }
}
