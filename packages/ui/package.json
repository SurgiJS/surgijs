{
  "name": "@surgijs/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible SurgiJS web components, themed with CSS custom properties and ready for SSR.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "surgijs",
    "web-components",
    "custom-elements",
    "ui",
    "design-system",
    "a11y"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurgiJS/surgijs.git",
    "directory": "packages/ui"
  },
  "homepage": "https://surgijs.github.io/surgijs/",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/SurgiJS/surgijs/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./themes.css": "./dist/themes.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@surgijs/core": "workspace:^"
  },
  "devDependencies": {
    "@surgijs/compiler": "workspace:*",
    "@surgijs/core": "workspace:*",
    "happy-dom": "^20.0.10"
  }
}
