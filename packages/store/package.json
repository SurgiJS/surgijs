{
  "name": "@surgijs/store",
  "version": "3.0.0",
  "description": "Framework-agnostic store: one object, lazy remote data, deep equality subscriptions, unload when unused. Adapters for React, Vue, Svelte, Angular and SurgiJS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "store",
    "state",
    "cache",
    "fetch",
    "reactive",
    "surgijs",
    "vue",
    "svelte",
    "angular"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurgiJS/surgijs.git",
    "directory": "packages/store"
  },
  "homepage": "https://surgijs.github.io/surgijs/",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/SurgiJS/surgijs/issues",
  "exports": {
    ".": {
      "@surgijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "@surgijs/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./core": {
      "@surgijs/source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./vue": {
      "@surgijs/source": "./src/vue.ts",
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "@surgijs/source": "./src/svelte.ts",
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./angular": {
      "@surgijs/source": "./src/angular.ts",
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "node bench/run.mjs"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "@surgijs/core": ">=0.5.0",
    "react": ">=18",
    "vue": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@surgijs/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^22.3.0",
    "@surgijs/core": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.3.0",
    "jotai": "^2.15.0",
    "nanostores": "^1.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "redux": "^5.0.1",
    "rxjs": "^7.8.2",
    "valtio": "^2.1.8",
    "vue": "^3.5.45",
    "zustand": "^5.0.8"
  }
}
