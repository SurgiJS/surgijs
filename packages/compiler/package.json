{
  "name": "@surgijs/compiler",
  "version": "0.2.0",
  "description": "SurgiJS JSX compiler with Vite, Rollup and esbuild plugins.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "surgijs",
    "jsx",
    "compiler",
    "vite-plugin",
    "esbuild-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurgiJS/surgijs.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://surgijs.github.io/surgijs/",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/SurgiJS/surgijs/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "typescript": ">=5.0 <7"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
