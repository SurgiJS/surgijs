{
  "name": "surgijs-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "size": "pnpm --filter @surgijs/core size",
    "dev": "pnpm --filter @surgijs/playground dev",
    "docs:dev": "pnpm --filter @surgijs/docs dev",
    "docs:build": "pnpm --filter @surgijs/docs build",
    "storybook": "pnpm --filter @surgijs/storybook dev",
    "storybook:build": "pnpm --filter @surgijs/storybook build",
    "test:e2e": "pnpm build && pnpm storybook:build && pnpm --filter @surgijs/storybook test:e2e",
    "test:e2e:update": "pnpm build && pnpm storybook:build && pnpm --filter @surgijs/storybook test:e2e:update",
    "bench": "pnpm --filter @surgijs/bench bench",
    "bench:store": "node packages/store/bench/run.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.0.10",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
