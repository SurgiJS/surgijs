{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "$description": "Text in components."
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "0.875rem", "$description": "Small text: the `sm` size of components." },
      "md": { "$value": "1rem", "$description": "Default text size of components." },
      "lg": { "$value": "1.125rem", "$description": "Large text: the `lg` size of components." }
    },
    "weight": {
      "$type": "fontWeight",
      "medium": { "$value": 500, "$description": "Button labels." }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px", "$description": "Small corners." },
    "md": { "$value": "6px", "$description": "Default corners of components." },
    "lg": { "$value": "8px", "$description": "Large corners." },
    "full": { "$value": "999px", "$description": "Pill-shaped corners." }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms", "$description": "Hover and press transitions." }
  }
}
